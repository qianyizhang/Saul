// All untrusted titles/IDs arrive as JSON data, never script source.
function run(argv) {
  const request = JSON.parse(argv[0]);
  const app = Application(request.browserPid);
  if (!app.running()) throw new Error('Connected Chrome process is no longer running');
  const windows = app.windows();
  const targets = request.windows.map(function (expected) {
    const window = windows.find(function (w) { return Number(w.id()) === expected.windowId; });
    if (!window || window.mode() !== 'normal') throw new Error('Normal window no longer exists');
    const actual = window.tabs.id().map(Number).sort(function (a, b) { return a - b; });
    const tabIds = expected.tabIds.slice().sort(function (a, b) { return a - b; });
    if (JSON.stringify(actual) !== JSON.stringify(tabIds)) throw new Error('Window tabs changed before native naming');
    const title = window.givenName();
    if (expected.expectedTitle !== undefined && title !== expected.expectedTitle)
      throw new Error('Native window name changed since preview');
    return { window: window, input: expected, title: title };
  });
  // Validate every destination before writing the first name.
  if (request.action === 'apply') targets.forEach(function (target) {
    if (target.window.givenName() !== target.title) throw new Error('Native window name changed during apply');
    target.window.givenName = target.input.title;
    if (target.window.givenName() !== target.input.title) throw new Error('Native window rename could not be verified');
  });
  return JSON.stringify(targets.map(function (target) {
    return { windowId: target.input.windowId, title: target.window.givenName() };
  }));
}
