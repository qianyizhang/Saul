{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "chrome"],
    "skipLibCheck": true,
    "noEmit": true,
    "erasableSyntaxOnly": true
  },
  "include": ["scripts/*.mts"]
}
