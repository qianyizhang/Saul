{
  "name": "saul",
  "description": "Local-first reading explanations and tab organization for Chrome.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "design:generate": "node ../../design/generate.mts --css assets/design-tokens.css --css native/ui/design-tokens.css --typescript src/design/tokens.ts",
    "design:check": "pnpm design:generate --check",
    "dev": "wxt",
    "build": "pnpm build:native && wxt build",
    "zip": "pnpm build:native && wxt zip",
    "typecheck": "node scripts/build-native.mts && tsc --noEmit && tsc -p tsconfig.tools.json && tsc -p tsconfig.tests.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check:links": "node ../../scripts/check-links.mts",
    "check": "pnpm design:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:links && pnpm test",
    "test": "pnpm build:native && vitest run",
    "saul": "node scripts/build-native.mts && node .build/native/cli.mjs",
    "native:install": "node scripts/build-native.mts && node .build/native/install.mjs",
    "mcp": "node scripts/build-native.mts && node .build/native/mcp.mjs",
    "postinstall": "wxt prepare",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:headed": "pnpm build && HEADED=1 playwright test",
    "benchmark": "pnpm build && playwright test --config tests/e2e/playwright.benchmark.config.ts",
    "test:user": "pnpm build && node tests/e2e/manual.ts",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "verify:connection": "node scripts/verify-connection.mts",
    "build:board": "node scripts/build-native.mts",
    "build:native": "node scripts/build-native.mts",
    "board": "node scripts/build-native.mts && node .build/native/board-web.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "marked": "18.0.13",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3",
    "zod": "4.6.7"
  }
}
