{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "chrome"],
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".build",
    "noEmitOnError": true,
    "declaration": true
  },
  "include": ["native/*.mts"]
}
