{
  "name": "saul",
  "description": "Local-first reading explanations and tab organization for Chrome.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check:links": "node scripts/check-links.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:links && pnpm test",
    "test": "vitest run",
    "saul": "node native/cli.mjs",
    "native:install": "node native/install.mjs",
    "mcp": "node native/mcp.mjs",
    "postinstall": "wxt prepare",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:headed": "pnpm build && HEADED=1 playwright test",
    "benchmark": "pnpm build && playwright test --config tests/e2e/playwright.benchmark.config.ts",
    "test:user": "pnpm build && node tests/e2e/manual.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.11.0",
    "github-slugger": "^2.0.0",
    "globals": "^17.12.0",
    "marked": "^18.0.13",
    "prettier": "3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
